# Required
OPENROUTER_API_KEY=
BRAVE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional (defaults shown)
# DEFAULT_MODEL=anthropic/claude-sonnet-4-5
# VAULT_PATH=./vault/keypo-intel
# BRIEFING_HOUR=7
# BRIEFING_MINUTE=0
# TIMEZONE=America/Los_Angeles
# SCRAPE_TIMEOUT=15
# SCRAPE_MAX_CHARS=8000
# JINA_API_KEY=              # Optional — recommended for production (free tier: ~20 RPM)
# JINA_TIMEOUT=30            # Seconds — Jina does server-side JS rendering
# JINA_FALLBACK_ENABLED=true # Set false to disable Jina fallback entirely
